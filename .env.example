# Copy this file to .env and fill in your own key.
# Never commit the real .env file.
#
# Voice: Modal endpoint for Meta Omnilingual ASR.
# Deploy modal_app/asr.py first, then paste the web URL and shared secret.
KOUMBA_ASR_URL=
KOUMBA_ASR_KEY=
#
# Active configuration: Meta Model API (the defaults).
KOUMBA_BASE_URL=https://api.meta.ai/v1
KOUMBA_API_KEY_ENV=MODEL_API_KEY
KOUMBA_MODEL=muse-spark-1.3
MODEL_API_KEY=
#
# To switch providers, comment out the active block above and uncomment one
# of the presets below.
#
# Preset: Meta Model API
# KOUMBA_BASE_URL=https://api.meta.ai/v1
# KOUMBA_API_KEY_ENV=MODEL_API_KEY
# KOUMBA_MODEL=muse-spark-1.3
# MODEL_API_KEY=
#
# Preset: Baseten
# TODO: paste the OpenAI-compatible base URL from Baseten's docs.
# KOUMBA_BASE_URL=https://YOUR-BASETEN-BASE-URL/v1
# KOUMBA_API_KEY_ENV=BASETEN_API_KEY
# KOUMBA_MODEL=meta-models/muse-spark-open-1026
# BASETEN_API_KEY=
#
# Preset: Fireworks
# KOUMBA_BASE_URL=https://api.fireworks.ai/inference/v1
# KOUMBA_API_KEY_ENV=FIREWORKS_API_KEY
# KOUMBA_MODEL=accounts/fireworks/models/muse-spark-open
# FIREWORKS_API_KEY=
